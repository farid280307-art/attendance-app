Options -Indexes
DirectoryIndex public/index.php

RewriteEngine On

# Jangan izinkan akses langsung ke source, konfigurasi, atau metadata project.
RewriteRule ^(?:\.git|app|config|database|routes)(?:/|$) - [F,L,NC]
RewriteRule ^(?:bootstrap\.php|AGENTS\.md|README\.md|\.gitignore)$ - [F,L,NC]

# Sajikan asset publik tanpa mengekspos folder source lain.
RewriteRule ^assets/(.*)$ public/assets/$1 [L]
RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

# File yang benar-benar ada tetap dilayani langsung oleh Apache.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Semua request aplikasi lainnya diarahkan ke front controller.
RewriteRule ^ public/index.php [QSA,L]
